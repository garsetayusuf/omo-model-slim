---
import Base from '../layouts/Base.astro';
import Reveal from '../components/Reveal';
import { SITE } from '../lib/config';
---

<Base title="Changelog — OMO Manager" description="Release history and highlights for OMO Manager.">
  <div class="container-page py-12 sm:py-16">
    <Reveal>
      <p class="eyebrow">Release history</p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">Changelog.</h1>
      <p class="mt-5 max-w-2xl text-muted">Version {SITE.version} is the first public release. Earlier development builds were not published.</p>
    </Reveal>

    <div class="mt-10 max-w-3xl">
      <Reveal>
        <article class="surface p-6 sm:p-8">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <h2 class="text-2xl font-bold text-ink">v1.0.0</h2>
            <a href={`${SITE.repo}/releases/tag/v1.0.0`} target="_blank" rel="noopener noreferrer" class="text-sm text-brand2 hover:text-white">GitHub release ↗</a>
          </div>
          <p class="mt-1 text-sm text-muted">Initial public release · stable</p>

          <h3 class="mt-8 text-sm font-semibold uppercase tracking-widest text-brand2">Highlights</h3>
          <ul class="mt-4 space-y-3 text-sm leading-6 text-muted">
            <li>Interactive, arrow-key terminal menu with searchable model lists and no numeric shortcuts.</li>
            <li>Schema-aware Slim editing: direct preset agents, nested agents, <code>extends</code> inheritance, root overrides, and <code>inheritModelFrom</code>.</li>
            <li>Ordered fallback chains and object model entries are preserved, including inline variants.</li>
            <li>OpenCode provider, custom model, MCP, and default-model management with comment-preserving atomic writes.</li>
            <li>Automatic timestamped backups, dry-run previews, verification, doctor checks, and one-step restore.</li>
            <li>Version-pinned installer with SHA-256 verification, rollback support, and no <code>sudo</code>.</li>
            <li>Astro documentation site with a browser-only xterm.js playground and responsive layouts.</li>
          </ul>

          <h3 class="mt-8 text-sm font-semibold uppercase tracking-widest text-brand2">Breaking changes</h3>
          <p class="mt-3 text-sm text-muted">None. This is the first public release.</p>

          <h3 class="mt-8 text-sm font-semibold uppercase tracking-widest text-brand2">Migration</h3>
          <p class="mt-3 text-sm leading-6 text-muted">
            No migration is required. Install the CLI and open it; it discovers your existing configuration at <code>~/.config/opencode/oh-my-opencode-slim.json</code> (or <code>.jsonc</code>) and <code>~/.config/opencode/opencode.json</code>. Your existing <code>omo-model</code> command is untouched.
          </p>
        </article>
      </Reveal>

      <Reveal>
        <div class="surface mt-6 p-6">
          <h2 class="text-lg font-semibold text-ink">Verify a release</h2>
          <p class="mt-2 text-sm leading-6 text-muted">Every release publishes a <code>SHA256SUMS</code> file generated in CI. The installer checks it before writing anything.</p>
          <a href={`${SITE.repo}/releases`} target="_blank" rel="noopener noreferrer" class="mt-4 inline-block text-sm text-brand2 hover:text-white">All releases ↗</a>
        </div>
      </Reveal>
    </div>
  </div>
</Base>
