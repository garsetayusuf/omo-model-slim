---
import Base from '../layouts/Base.astro';
import Reveal from '../components/Reveal';
import TerminalWindow from '../components/TerminalWindow';
import { SITE } from '../lib/config';
---

<Base title="Interactive playground — OMO Manager" description="Try OMO Manager's model, preset, fallback and MCP workflows in a browser-only terminal simulation.">
  <div class="container-page py-12 sm:py-16">
    <Reveal>
      <p class="eyebrow">Browser-only simulation</p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">Interactive playground.</h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted">
        Navigate the same menus as the real CLI. Change models, explore preset inheritance, manage fallbacks and toggle MCP servers — with deterministic demo data.
      </p>
      <div class="mt-5 flex flex-wrap gap-2 text-xs text-muted">
        <span class="badge">No login</span>
        <span class="badge">No shell commands</span>
        <span class="badge">No local file access</span>
        <span class="badge">v{SITE.version}</span>
      </div>
    </Reveal>

    <Reveal delay={0.08}>
      <div class="mt-10"><TerminalWindow autoFocus title="OMO Manager — demo session" client:load /></div>
    </Reveal>

    <Reveal delay={0.12}>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="surface p-5"><h2 class="font-semibold text-ink">Keyboard</h2><p class="mt-2 text-sm text-muted">Arrow keys move, Enter opens, Esc goes back. Type in the model list to search.</p></div>
        <div class="surface p-5"><h2 class="font-semibold text-ink">Touch</h2><p class="mt-2 text-sm text-muted">Use the ↑ ↓ Enter Esc buttons below the terminal on phones and tablets.</p></div>
        <div class="surface p-5"><h2 class="font-semibold text-ink">Reset</h2><p class="mt-2 text-sm text-muted">The Reset button restores the initial demo state at any time.</p></div>
        <div class="surface p-5"><h2 class="font-semibold text-ink">Safety</h2><p class="mt-2 text-sm text-muted">Nothing is saved. Closing this page discards every change you make here.</p></div>
      </div>
    </Reveal>

    <Reveal>
      <p class="mt-8 text-sm text-muted">
        Want the real thing? Read the <a href="/docs/installation" class="text-brand2 underline underline-offset-4">installation guide</a> or open the <a href={SITE.repo} target="_blank" rel="noopener noreferrer" class="text-brand2 underline underline-offset-4">source repository ↗</a>.
      </p>
    </Reveal>
  </div>
</Base>
