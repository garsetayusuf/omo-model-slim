---
import Base from '../layouts/Base.astro';
import Reveal from '../components/Reveal';
import InstallCommand from '../components/InstallCommand';
import TerminalWindow from '../components/TerminalWindow';
import { SITE } from '../lib/config';

const features = [
  { title: 'Agent models', body: 'Change any agent model in a preset or at the root, with fallbacks preserved automatically.', icon: '◈' },
  { title: 'Presets & inheritance', body: 'Resolve extends chains, variants, and inheritModelFrom without hand-editing JSON.', icon: '◇' },
  { title: 'Providers & models', body: 'Manage custom OpenCode providers and model definitions from one menu.', icon: '⬡' },
  { title: 'MCP servers', body: 'Add, toggle, and remove local or remote MCP servers with safe atomic writes.', icon: '⌁' },
  { title: 'Safety first', body: 'Automatic backups, JSONC-preserving edits, dry-run previews, and one-step restore.', icon: '✓' },
  { title: 'Diagnostics', body: 'Verify assignments against the live model registry and run a full doctor check.', icon: '⌕' },
];

const platforms = [
  { name: 'macOS', detail: 'Intel & Apple Silicon' },
  { name: 'Linux', detail: 'Ubuntu, Debian, Fedora' },
  { name: 'WSL 2', detail: 'Windows Subsystem for Linux' },
];

const steps = [
  { n: '01', title: 'Install', body: 'Run the one-line installer. It needs Python 3.10+ and curl, and never asks for sudo.' },
  { n: '02', title: 'Launch', body: 'Type omo-model-slim to open the keyboard-driven menu. No numeric shortcuts to memorize.' },
  { n: '03', title: 'Configure', body: 'Pick a preset, agent, and model. Preview the change, then confirm. Fallbacks stay intact.' },
  { n: '04', title: 'Restart', body: 'Restart OpenCode to apply. Your previous config is always one restore away.' },
];

const faqs = [
  { q: 'Does this replace my existing omo-model command?', a: 'No. The installer writes only ~/.local/bin/omo-model-slim. Your existing omo-model executable is left untouched.' },
  { q: 'Will my comments and fallback models be lost?', a: 'No. Edits are positional and JSONC-aware, so comments, formatting, unrelated keys, and every fallback model are preserved.' },
  { q: 'Is the website terminal a real shell?', a: 'No. Both the homepage preview and the playground run a deterministic browser-only simulation. They cannot execute commands or access your files.' },
  { q: 'Where are configuration files stored?', a: 'Slim settings live in ~/.config/opencode/oh-my-opencode-slim.json (or .jsonc). OpenCode settings live in ~/.config/opencode/opencode.json (or .jsonc).' },
  { q: 'How do I undo a change?', a: 'Every write creates a timestamped backup next to the config. Use Backup and restore in the menu, or the restore subcommand.' },
];
---

<Base>
  <div class="relative overflow-hidden">
    <div class="hero-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>

    <section class="container-page relative grid items-center gap-12 py-16 sm:py-20 lg:grid-cols-[1fr_1.05fr] lg:py-24">
      <div>
        <Reveal>
          <p class="eyebrow mb-5">Lightweight · Open source · Cross-platform</p>
        </Reveal>
        <Reveal delay={0.06}>
          <h1 class="text-4xl font-bold leading-[1.08] tracking-tight text-ink sm:text-5xl lg:text-6xl">
            Your models.<br />Your agents.<br /><span class="bg-gradient-to-r from-brand2 to-[#7dd3fc] bg-clip-text text-transparent">One terminal.</span>
          </h1>
        </Reveal>
        <Reveal delay={0.12}>
          <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">{SITE.description}</p>
        </Reveal>
        <Reveal delay={0.18}>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#install" class="btn-primary">Get started</a>
            <a href="/playground" class="btn-ghost">Try the playground →</a>
            <a href={SITE.repo} target="_blank" rel="noopener noreferrer" class="btn-ghost">GitHub ↗</a>
          </div>
        </Reveal>
        <Reveal delay={0.24}>
          <div class="mt-8 flex flex-wrap gap-2 text-xs text-muted">
            <span class="badge">Python 3.10+</span>
            <span class="badge">No sudo</span>
            <span class="badge">JSONC-safe</span>
            <span class="badge">v{SITE.version}</span>
          </div>
        </Reveal>
      </div>
      <Reveal delay={0.12}>
        <TerminalWindow compact autoFocus={false} title="Terminal preview" client:visible />
      </Reveal>
    </section>

    <section class="container-page relative py-12" aria-labelledby="features-heading">
      <Reveal>
        <p class="eyebrow">Built for daily use</p>
        <h2 id="features-heading" class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">Everything in one CLI.</h2>
        <p class="mt-3 max-w-2xl text-muted">A single dependency-free Python app for the configuration work that used to mean opening three JSON files.</p>
      </Reveal>
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {features.map((feature, index) => (
          <Reveal delay={index * 0.04}>
            <article class="surface group h-full p-6 transition-transform duration-200 hover:-translate-y-1 hover:border-brand2/50">
              <span aria-hidden="true" class="grid h-10 w-10 place-items-center rounded-lg bg-brand/15 font-mono text-lg text-brand2">{feature.icon}</span>
              <h3 class="mt-5 text-lg font-semibold text-ink">{feature.title}</h3>
              <p class="mt-2 text-sm leading-6 text-muted">{feature.body}</p>
            </article>
          </Reveal>
        ))}
      </div>
    </section>

    <section class="container-page relative py-16" aria-labelledby="platforms-heading">
      <Reveal>
        <h2 id="platforms-heading" class="text-3xl font-bold tracking-tight sm:text-4xl">Runs where you work.</h2>
        <p class="mt-3 text-muted">One installer, the same command, across your machines.</p>
      </Reveal>
      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        {platforms.map((platform, index) => (
          <Reveal delay={index * 0.05}>
            <div class="surface flex items-center justify-between p-5">
              <div><p class="font-semibold text-ink">{platform.name}</p><p class="mt-1 text-sm text-muted">{platform.detail}</p></div>
              <span class="text-mint" aria-hidden="true">✓</span>
            </div>
          </Reveal>
        ))}
      </div>
      <Reveal>
        <p class="mt-5 text-sm text-muted">WSL 1 is supported on a best-effort basis. Native Windows PowerShell is not a target.</p>
      </Reveal>
    </section>

    <section id="install" class="container-page relative scroll-mt-24 py-16" aria-labelledby="install-heading">
      <Reveal>
        <h2 id="install-heading" class="text-3xl font-bold tracking-tight sm:text-4xl">Install in seconds.</h2>
        <p class="mt-3 max-w-2xl text-muted">Review the script, run it, and you are done. No sudo, no system-wide changes.</p>
      </Reveal>
      <Reveal delay={0.08}><div class="mt-8"><InstallCommand client:load /></div></Reveal>
      <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
        {steps.map((step, index) => (
          <Reveal delay={index * 0.05}>
            <div class="surface h-full p-5">
              <span class="font-mono text-sm text-brand2">{step.n}</span>
              <h3 class="mt-3 font-semibold text-ink">{step.title}</h3>
              <p class="mt-2 text-sm leading-6 text-muted">{step.body}</p>
            </div>
          </Reveal>
        ))}
      </div>
    </section>

    <section class="container-page relative py-16" aria-labelledby="faq-heading">
      <Reveal>
        <h2 id="faq-heading" class="text-3xl font-bold tracking-tight sm:text-4xl">Frequently asked questions.</h2>
      </Reveal>
      <div class="mt-8 grid gap-4 lg:grid-cols-2">
        {faqs.map((faq, index) => (
          <Reveal delay={index * 0.04}>
            <details class="surface group p-5">
              <summary class="cursor-pointer list-none font-medium text-ink marker:hidden">{faq.q}<span class="float-right text-brand2 group-open:rotate-45" aria-hidden="true">+</span></summary>
              <p class="mt-3 text-sm leading-6 text-muted">{faq.a}</p>
            </details>
          </Reveal>
        ))}
      </div>
    </section>

    <section class="container-page relative pb-8 pt-4">
      <Reveal>
        <div class="surface flex flex-wrap items-center justify-between gap-6 p-8 sm:p-10">
          <div>
            <h2 class="text-2xl font-bold sm:text-3xl">Explore before installing.</h2>
            <p class="mt-2 max-w-xl text-sm text-muted">The playground is a safe browser-only simulation. No login, server shell, or credentials needed.</p>
          </div>
          <a href="/playground" class="btn-primary">Open playground →</a>
        </div>
      </Reveal>
    </section>
  </div>
</Base>
